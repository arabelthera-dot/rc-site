{
  "name": "rc-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node --max-old-space-size=1400 ./node_modules/astro/bin/astro.mjs build && node scripts/versii.mjs dist",
    "versii": "node scripts/versii.mjs dist",
    "preview": "astro preview",
    "import": "node scripts/redirects.mjs && node scripts/full-pages.mjs",
    "full-pages": "node scripts/full-pages.mjs",
    "proverka-podpisey": "node scripts/proverka-podpisey.mjs",
    "og-razmer": "node scripts/og-razmer.mjs dist",
    "priemka": "node -e \"import('./src/lib/dni-shablon.mjs').then(async (m) => console.log(await m.otchetPriemki(process.argv[1])))\""
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.4.0",
    "photoswipe": "^5.4.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.55.1",
    "pagefind": "^1.5.2",
    "playwright": "1.55.1"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "basic-ftp": "^6.2.3"
  }
}
