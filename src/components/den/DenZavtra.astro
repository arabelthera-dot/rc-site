---
// «Вернись завтра» на странице дня — общий движок возврата museum-return.js (M-99, «да» Сергея 09.08),
// календарь музея — один файл на музей (muzei/<музей>/kalendar-dney.js), а не копия в каждой странице.
// Намёк на завтра (дата + название + хук + ссылка, Сергей 17.10) свёрстан и в HTML — виден без JS,
// движок заменяет блок своим (с «открытыми днями»). Завтра у датированного музея — календарный +1
// (как в движке: нет карточки на эту дату — намёка нет), у недатированного — следующая запись.
interface Day { key: string; title: string; year?: string | number; hook?: string }
// mark=false — дата без карточки («День готовится»): движок не отмечает её открытым днём, намёк на завтра — из вёрстки.
interface Props { museum: string; day: string; dated: boolean; days: Day[]; when: (key: string) => string; mark?: boolean }
const { museum, day, dated, days, when, mark = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const DIM = [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
const pad = (n: number) => (n < 10 ? '0' : '') + n;
const plusOne = (k: string) => { let m = +k.slice(0, 2), d = +k.slice(3) + 1;
  if (d > DIM[m - 1]) { d = 1; m = m === 12 ? 1 : m + 1; } return `${pad(m)}-${pad(d)}`; };
// 29 февраля без карточки — завтра после 28-го 1 марта (невисокосный год; так же в museum-return.js, ревизия Р119).
const p1 = dated ? plusOne(day) : undefined;
const nk = dated ? (p1 === '02-29' && !days.some((x) => x.key === '02-29') ? '03-01' : p1) : days.map((x) => x.key).sort().find((k) => k > day);
const nx = nk ? days.find((x) => x.key === nk) : undefined;
const href = nx && `${base}muzei/${museum}/den/${nx.key}/`;
---
<section class="block" id="return" aria-labelledby="rt-title">
  {nx && (
    <div class="rt-box">
      <h2 id="rt-title">Вернись завтра</h2>
      <div class="rt-part">
        <div class="rt-lbl">{dated ? `Завтра, ${when(nx.key)}` : `Завтра — ${when(nx.key).replace('День', 'день')}`}</div>
        <p><a href={href}>«{nx.title}»</a>{nx.year && <span> ({nx.year})</span>}</p>
        {nx.hook && <p class="rt-hook">{nx.hook}</p>}
      </div>
    </div>
  )}
</section>
{mark && <>
<script is:inline defer src={`${base}muzei/${museum}/kalendar-dney.js`}></script>
<script is:inline defer src={`${base}assets/museum-return.js`} data-museum={museum} data-day={day}></script>
</>}
