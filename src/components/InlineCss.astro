---
// Инлайн общего стиля из public/assets/ прямо в <head> (render-blocking, Lighthouse 18.10): мелкий CSS первого
// экрана не ходит отдельным запросом, FCP не ждёт сеть. Относительные url(...) в файле считаются от
// public/assets/ — переписываются на абсолютные с base, иначе шрифты и картинки потеряются.
// Файл остаётся в public/assets/ как был: на него ссылаются старые страницы (full-pages, sitebar.mjs).
interface Props { file: string }
const { file } = Astro.props;
const fs = await import('node:fs');
const base = import.meta.env.BASE_URL;
const css = fs.readFileSync(`public/assets/${file}`, 'utf8')
  .replace(/url\((['"]?)(?![a-z]+:|\/|#|data:)([^'")]+)\1\)/gi, (_m, q, p) => `url(${q}${base}assets/${p}${q})`);
---
<style is:inline set:html={css} />
