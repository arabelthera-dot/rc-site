---
import { yazyk, razobratPut, stroka, strelkaVpered } from '../../lib/yazyki.mjs';
const lang = yazyk(razobratPut(Astro.url.pathname, import.meta.env.BASE_URL).code);
const s = (key: string): any => stroka(lang.code, key);
const base = import.meta.env.BASE_URL;
// Б10 (опись Р84): пустой музей — не тупик; ближайшие заполненные дни соседних музеев.
interface Props { sosedi?: { title: string; href: string; when: string; museum: string }[] }
const { sosedi = [] } = Astro.props;
---
<section class="mh-sec" id="kuda-dalshe">
  <h2 class="mh-h">{s('kudaDalshe')}</h2>
  {sosedi.length > 0 && (<>
    <p>{s('sosediSegodnya')}</p>
    <ul class="mh-open">{sosedi.map((d) => <li><a href={d.href}><span class="w">{d.when}</span>{d.title} — {d.museum}</a></li>)}</ul>
  </>)}
  <p><a href={base}>{`${s('gorodVseMuzei')} ${strelkaVpered(lang.dir)}`}</a></p>
</section>
