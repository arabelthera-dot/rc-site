---
// «Сегодня в музее»: день выбирается на клиенте по сегодняшней московской дате (ключ ММ-ДД),
// запасной — ближайший следующий заполненный день. Без JS виден первый день календаря.
interface Props { first?: { key: string; title: string; hook: string; href: string; when: string }; dated: boolean }
const { first, dated } = Astro.props;
import { yazyk, razobratPut, stroka, strelkaVpered } from '../../lib/yazyki.mjs';
const lang = yazyk(razobratPut(Astro.url.pathname, import.meta.env.BASE_URL).code);
const s = (key: string): any => stroka(lang.code, key);
// строки встроенного скрипта — текущего языка, из словаря (stroki.json), а не из кода скрипта
const strokiSkripta = JSON.stringify({ mon: s('mesyacy'), monR: s('mesyacyR'), den: s('denMesyac'), seg: s('segodnyaPrefiks'), bliz: s('blizhayshiyPrefiks') });
---
<section class="mh-sec" id="segodnya">
  <h2 class="mh-h">{s('segodnyaVMuzee')}</h2>
  {first ? (
    <article class="day mh-today" data-dated={dated ? '1' : '0'} data-stroki={strokiSkripta}>
      <div class="cdate" data-today-when>{first.when}</div>
      <h3 data-today-title>{first.title}</h3>
      <p class="hook" data-today-hook>{first.hook}</p>
      <a class="mh-more" data-today-href href={first.href}>{`${s('otkrytDen')} ${strelkaVpered(lang.dir)}`}</a>
    </article>
  ) : (
    <p class="mh-empty">{s('eksponatyGotovyatsya')}</p>
  )}
</section>
{first && (
<script is:inline>
(function(){
  var C = window.MUSEUM_CALENDAR || {}, keys = Object.keys(C).filter(function(k){ return /^\d\d-\d\d$/.test(k); }).sort();
  if (!keys.length) return;
  // «Сегодня» — по Москве, как в portal/Segodnya.astro и DenPoDate.astro (B11, 19.10.2026):
  // местное время браузера давало посетителю в другом поясе не тот день, что остальной сайт.
  var q = {}; new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Moscow', month: '2-digit', day: '2-digit' })
    .formatToParts(new Date()).forEach(function (x) { q[x.type] = x.value; });
  var tk = q.month + '-' + q.day;
  var k = C[tk] ? tk : (keys.filter(function(x){ return x >= tk; })[0] || keys[0]);
  var it = C[k], box = document.querySelector('.mh-today'); if (!box || !it) return;
  var S = JSON.parse(box.getAttribute('data-stroki') || '{}'); if (!S.mon) return;
  var mm = +k.slice(0, 2), dd = +k.slice(3), dated = box.getAttribute('data-dated') === '1';
  var when = dated ? dd + ' ' + S.monR[mm - 1] : S.den.replace('{d}', dd).replace('{m}', S.mon[mm - 1]);
  box.querySelector('[data-today-when]').textContent = (k === tk ? S.seg : S.bliz) + when;
  box.querySelector('[data-today-title]').textContent = it.t;
  box.querySelector('[data-today-hook]').textContent = it.d;
  box.querySelector('[data-today-href]').setAttribute('href', it.href);
})();
</script>
)}
