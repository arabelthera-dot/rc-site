---
// Календарь на главной (02-calendar.md §1-бис-6): окошко месяца #calbox + museum-calendar-month.js
// и строка «Весь год целиком» на страницу календаря. Страницы календаря нет (нет дней) — строка без ссылки.
interface Props { slug: string; total: number }
const { slug, total } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<section class="mh-sec" id="calendar">
  <h2 class="mh-h">Календарь года</h2>
  <div id="calbox"></div>
  {total > 0
    ? <p class="mh-year"><a href={`${base}muzei/${slug}/calendar/`}>Весь год целиком — {total} {total % 10 === 1 && total % 100 !== 11 ? 'день' : [2,3,4].includes(total % 10) && ![12,13,14].includes(total % 100) ? 'дня' : 'дней'} в календаре музея →</a></p>
    : <p class="mh-year mh-empty">Весь год целиком — календарь музея наполняется, страница года откроется с первым днём.</p>}
</section>
<script is:inline src={`${base}assets/museum-calendar-month.js`}></script>
