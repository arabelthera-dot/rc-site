---
import poiskVitrin from '../../../data/poisk-vitrin.json';
// Главная музея — минимум 05-main-page.md §6-quinquies (8 блоков) для ЛЮБОГО музея из museums.json.
// У музея без дней — честные пустые состояния, ссылок на несуществующие страницы нет.
import Base from '../../../layouts/Base.astro';
import { ogRaster } from '../../../lib/og-den.mjs';
import { getCollection } from 'astro:content';
import { beyondYear, isDated } from '../../../lib/kalendar';
import { yazyk, razobratPut, stroka, strelkaVpered } from '../../../lib/yazyki.mjs';
import Cover from '../../../components/home/Cover.astro';
import Today from '../../../components/home/Today.astro';
import Calendar from '../../../components/home/Calendar.astro';
import Themes from '../../../components/home/Themes.astro';
import OpenDays from '../../../components/home/OpenDays.astro';
import Council from '../../../components/home/Council.astro';
import Support from '../../../components/home/Support.astro';
import KudaDalshe from '../../../components/home/KudaDalshe.astro';
export async function getStaticPaths() {
  const days = await getCollection('days');
  const museums = await getCollection('museums');
  const imena = Object.fromEntries(museums.map((m) => [m.data.slug, m.data.title_ru]));
  // Б10 (опись Р84): заполненные дни (готовая страница) всех музеев — для пустого музея «Куда дальше»
  const polnye = days.filter((d) => d.data.legacy_page).map((d) => ({ museum: d.data.museum, key: d.data.key, title: d.data.title, imya: imena[d.data.museum] }));
  return museums.map((m) => ({
    params: { slug: m.data.slug },
    props: { m: m.data, polnye: polnye.filter((d) => d.museum !== m.data.slug), days: days.filter((d) => d.data.museum === m.data.slug).map((d) => d.data).sort((a, b) => a.key.localeCompare(b.key)) },
  }));
}
const { m, days, polnye } = Astro.props;
const base = import.meta.env.BASE_URL;
// «Поддержать проект» — на всех страницах (Р88, 21.10.2026, заменяет Р31); выключение — PUBLIC_PODDERZHKA=0.
const podderzhka = import.meta.env.PUBLIC_PODDERZHKA !== '0';
// Служебные строки шаблона — по языку страницы (Г20, src/data/stroki.json); русский вывод не меняется.
const lang = yazyk(razobratPut(Astro.url.pathname, base).code);
const s = (key: string): any => stroka(lang.code, key);
const MON: string[] = s('mesyacy');
const MONR: string[] = s('mesyacyR');
const dated = isDated(m.slug);
const href = (k: string) => `${base}muzei/${m.slug}/den/${k}/`;
const when = (k: string) => { const mm = +k.slice(0, 2), dd = +k.slice(3); return dated ? `${dd} ${MONR[mm - 1]}` : s('denMesyac').replace('{d}', String(dd)).replace('{m}', MON[mm - 1]); };
// данные окошка месяца — только ключи дней (движок считает «заполнено» по числу ключей)
// записи сверх года (src/lib/kalendar.ts) в окошко и счётчик года не идут, на главной — группой «Сверх года»
const beyond = (k: string) => beyondYear(k, dated);
const yearDays = days.filter((d) => !beyond(d.key));
const extra = days.filter((d) => beyond(d.key));
const cal: Record<string, unknown> = {};
for (const d of yearDays) cal[d.key] = { t: d.title, y: d.year, d: d.hook ?? '', href: href(d.key), link: `${s('otkrytDen')} ${strelkaVpered(lang.dir)}` };
const img = days.flatMap((d) => d.images).find((i) => !i.generated);
// Картинка пересылки без обложки музея — первая настоящая растровая картинка дней (Base.astro, ogFallback).
// WebP — JPG/PNG-двойником (ogRaster, Б9 19.10).
const ogFallback = days.flatMap((d) => d.images).filter((i) => !i.generated).map((i) => ogRaster(i.src)).find(Boolean);
const first = days[0] && { key: days[0].key, title: days[0].title, hook: days[0].hook, href: href(days[0].key), when: when(days[0].key) };
const groups = MON.map((name, i) => ({ name: name[0].toUpperCase() + name.slice(1),
  days: yearDays.filter((d) => +d.key.slice(0, 2) === i + 1).map((d) => ({ title: d.title, href: href(d.key) })) }))
  .concat(extra.length ? [{ name: s('sverhGoda'), days: extra.map((d) => ({ title: d.title, href: href(d.key) })) }] : []).filter((g) => g.days.length);
const featured = [...days.filter((d) => d.legacy_page || d.images.length), ...days.filter((d) => !(d.legacy_page || d.images.length))].slice(0, 12)
  .map((d) => ({ title: d.title, href: href(d.key), when: when(d.key) }));
// Б10: у музея нет ни одного полного дня — ближайшие к сегодняшней дате (сборки) полные дни соседей, по одному на музей, 4 штуки
const segK = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Moscow' }).slice(5);
const vidennye = new Set<string>();
const sosedi = days.some((d) => d.legacy_page) ? [] : [...polnye]
  .filter((d) => /^\d\d-\d\d$/.test(d.key))
  .sort((a, b) => ((a.key < segK ? '1' : '0') + a.key).localeCompare((b.key < segK ? '1' : '0') + b.key))
  .filter((d) => !vidennye.has(d.museum) && vidennye.add(d.museum))
  .slice(0, 4)
  .map((d) => { const mm = +d.key.slice(0, 2), dd = +d.key.slice(3); return { title: d.title, href: `${base}muzei/${d.museum}/den/${d.key}/`, when: `${dd} ${MONR[mm - 1]}`, museum: d.imya }; });
const poisk = (poiskVitrin.vitriny as Record<string, { hvost: string; opisanie: string }>)[m.slug];
---
<Base title={poisk?.hvost ? `${m.title_ru} — ${poisk.hvost}` : m.title_ru} ogTitle={m.title_ru} description={poisk?.opisanie ?? m.promise_ru} ogDescription={m.promise_ru} museum={m.slug} museumTitle={m.title_ru} ogFallback={ogFallback} rss={{ href: `${base}muzei/${m.slug}/rss.xml`, title: `${m.title_ru} — ${s('novyeDni')}` }}>
  <Cover slot="header" m={m} img={img} />
  <script is:inline define:vars={{ cal }}>window.MUSEUM_CALENDAR = cal;</script>
  <Today first={first} dated={dated} />
  {podderzhka && <div class="mh-supslot" data-support-slot></div>}
  <Calendar slug={m.slug} total={yearDays.length} />
  <Themes groups={groups} />
  <OpenDays days={featured} total={yearDays.length} calHref={days.length ? `${base}muzei/${m.slug}/calendar/` : undefined} />
  <Council />
  <KudaDalshe sosedi={sosedi} />
  <Support museum={m.title_ru} />
  <a slot="footer" href={base}>{`${s('vyytiVGorod')} ${strelkaVpered(lang.dir)}`}</a>
</Base>
