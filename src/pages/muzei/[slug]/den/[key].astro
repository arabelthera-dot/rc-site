---
// Страница дня (экспоната дня) — порядок блоков по 04-build.md §6/§6-бис:
// шапка top (4 строки) → крошки → обложка-сцена + этикетка (если есть картинка) → подводка hero-lead
// (дата, h1, хук как есть, кнопки) → «Поддержать проект» (museum-support.js, первая треть) →
// суть + прочие картинки → источник → навигация дней → «Куда дальше» (дубль поддержки) → подвал.
// Нет поля в карточке — блока нет; тексты карточки выводятся дословно.
import Base from '../../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import DenMedia from '../../../../components/den/DenMedia.astro';
import DenZavtra from '../../../../components/den/DenZavtra.astro';
import Credit from '../../../../components/den/Credit.astro';
const MON = ['январь','февраль','март','апрель','май','июнь','июль','август','сентябрь','октябрь','ноябрь','декабрь'];
const MONR = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
export async function getStaticPaths() {
  const museums = await getCollection('museums');
  const days = (await getCollection('days')).sort((a, b) => a.data.key.localeCompare(b.data.key));
  return days.map((d) => {
    const own = days.filter((x) => x.data.museum === d.data.museum);
    const i = own.indexOf(d);
    return { params: { slug: d.data.museum, key: d.data.key },
      props: { d: d.data, m: museums.find((x) => x.id === d.data.museum)!.data, prev: own[i - 1]?.data, next: own[i + 1]?.data,
        keys: own.map((x) => x.data.key), own: own.map((x) => x.data) } };
  });
}
const { d, m, prev, next, keys, own } = Astro.props;
const base = import.meta.env.BASE_URL;
const fs = await import('node:fs');
const dated = JSON.parse(fs.readFileSync(`src/data/calendar-meta-${m.slug}.json`, 'utf8')).dated;
// Подпись дня: у датированного музея — дата, у недатированного — номер записи «День N · месяц»
// (ключ там не дата: у первопроходцев есть 12-32, 12-33); одно правило для шапки дня и стрелок соседей.
const whenOf = (key: string) => { const mm = parseInt(key.slice(0, 2)), dd = parseInt(key.slice(3));
  return dated ? `${dd} ${MONR[mm - 1]}` : `День ${dd} · ${MON[mm - 1]}`; };
const when = whenOf(d.key);
// Дата в <title> и карточке пересылки: «17 октября 1944: …» (п.2 очереди 1, 17.10).
const dateTitle = d.year ? (dated ? `${when} ${d.year}` : `${when} · ${d.year}`) : when;
const museumUrl = `${base}muzei/${m.slug}/`;
const cal = `${museumUrl}calendar/`;
const dayUrl = (k: string) => `${museumUrl}den/${k}/`;
const url = (src: string) => (/^https?:/.test(src) ? src : `${base}${src.replace(/^\//, '')}`);
const [cover, ...rest] = d.images.map((i) => ({ ...i, src: url(i.src) }));
// Поле mechanic — описание задачи для разработки (след черновика, 04-build «Заголовок и подписи»);
// посетителю его не показываем, интерактив придёт движком при переносе (шаг 4 плана).
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const legacy = d.legacy_page ? `https://arabelthera-dot.github.io/rc-museum-preview/${d.legacy_page}` : undefined;
// museum-chrome.js (движок старого сайта, как есть): «Поделиться», липкие стрелки, строка «Случайное».
// Случайный день — адресом с index.html: движок сравнивает последний кусок адреса, а у нас он пустой.
const dayName = (x: { key: string; title: string }) => `${whenOf(x.key)} · ${x.title}`;
const chrome = `window.MUSEUM_CHROME=${JSON.stringify({
  museum: { title: m.title_ru, href: museumUrl },
  share: { title: `${d.title} — ${m.title_ru}`, text: d.hook ?? d.title },
  prev: prev && { href: dayUrl(prev.key), title: dayName(prev) },
  next: next && { href: dayUrl(next.key), title: dayName(next) },
  all: { href: cal, label: 'Все дни календаря' },
  city: base,
  random: keys.filter((k: string) => k !== d.key).map((k: string) => `${dayUrl(k)}index.html`),
})};`;
const support = `window.MUSEUM_SUPPORT=${JSON.stringify({ museum: m.title_ru, page: `странице «${d.title}»`})};`;
---
<Base ownStyle title={`${dateTitle}: ${d.title} — ${m.title_ru} — Русская цивилизация`} ogTitle={`${dateTitle}: ${d.title}`}
  description={d.hook ?? `${d.title} — ${m.title_ru}`} museum={m.slug}
  image={cover?.src} imageAlt={cover?.caption} type="article"
  crumbs={[{ href: museumUrl, label: m.title_ru }, { href: cal, label: 'Календарь' }, { label: `${when} · ${d.title}` }]}
  back={{ href: cal, label: 'Календарь' }}>
  <Fragment slot="head">
    <link rel="stylesheet" href={`${base}assets/fonts.css`} />
    <link rel="stylesheet" href={`${base}assets/museum-theme.css`} />
  </Fragment>

  <header slot="header" class="top">
    <div class="b1">Русская цивилизация</div>
    <div class="b2">Первый цифровой музей достижений России · Цивилизация первенств — что Россия дала миру раньше всех</div>
    <div class="top-sep"></div>
    <div class="museum">{m.title_ru}</div>
    {m.slogan_ru && <div class="museum-slog">{m.slogan_ru}</div>}
  </header>

  <article class="dp">
    {cover && (
      <figure class="hero-scene">
        <a href={cover.src} target="_blank" rel="noopener" aria-label="Открыть картинку целиком"><img src={cover.src} alt={cover.caption} /></a>
        <figcaption class="scene-caption"><span class="cap">{cover.caption}</span> <Credit text={cover.credit} /></figcaption>
      </figure>
    )}

    <header class="hero-lead">
      <div class="date-chip">{when}{d.year && ` · ${d.year}`}</div>
      <h1>{d.title}</h1>
      {d.hook && <p class="hook">{d.hook}</p>}
      <div class="hero-btns">
        {d.gist && <a class="btn gold" href="#sut">Читать историю ↓</a>}
        {legacy && <a class="btn ghost" href={legacy}>Полная страница экспоната</a>}
        {!d.gist && !legacy && <a class="btn ghost" href={cal}>Календарь музея</a>}
      </div>
    </header>

    <div class="dp-sup" data-support-slot></div>

    {(d.gist || rest.length > 0) && (
      <section class="block" id="sut">
        <h2>Суть</h2>
        {d.gist && <p>{cap(d.gist)}</p>}
        {rest.map((im) => (
          <figure class="fig"><a href={im.src} target="_blank" rel="noopener"><img src={im.src} alt={im.caption} loading="lazy" /></a>
            <figcaption>{im.caption} <Credit text={im.credit} /></figcaption></figure>))}
      </section>
    )}
    <DenMedia video={d.video} audio={d.audio} where={`${m.slug}/${d.key}`} />
    {d.source && (
      <section class="block" id="istochnik">
        <h2>Источник</h2>
        <p>{d.source}</p>
      </section>
    )}
  </article>

  <nav class="dp-nav" aria-label="Соседние дни">
    {prev ? <a href={dayUrl(prev.key)}>← предыдущий</a> : <span></span>}
    <a href={cal}>все дни</a>
    {next ? <a href={dayUrl(next.key)}>следующий →</a> : <span></span>}
  </nav>

  <DenZavtra museum={m.slug} day={d.key} dated={dated} days={own} when={whenOf} />

  <section class="block" id="kuda-dalshe">
    <h2>Музей продолжается</h2>
    <div class="dp-links">
      <a href={museumUrl}>{m.title_ru}</a>
    </div>
  </section>

  <Fragment slot="footer">
    <div class="dp-foot">
      <a href={museumUrl}>← {m.title_ru}</a> · <a href={base}>в город-музей →</a>
    </div>
    <div class="dp-err">Нашли неточность? <a href={`mailto:arabelthera@gmail.com?subject=${encodeURIComponent(`Ошибка: ${m.title_ru}, ${d.key}`)}`}>Сообщите нам</a> — проверим по источникам.</div>
  </Fragment>

  <script is:inline set:html={chrome}></script>
  <script is:inline src={`${base}assets/museum-chrome.js`}></script>
  <script is:inline set:html={support}></script>
  <script is:inline src={`${base}assets/museum-support.js`}></script>
</Base>
