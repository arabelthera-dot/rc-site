---
// Календарь 1:1 со старым (muzei/ne-sdayutsya/calendar.html): тот же движок assets/museum-calendar-page.js,
// данные собираются из карточек дней; у каждого дня — ссылка на его страницу.
import { ogRaster } from '../../../lib/og-den.mjs';
// День с записью — ссылка <a href> на свою страницу (приёмка 20.10: кнопку не открыть в новой вкладке, поиск её не видит);
// обычный клик движок перехватывает и открывает карточку, как раньше; пустой день — по-прежнему disabled-кнопка.
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { kalendarMuzeya } from '../../../lib/kalendar-dannye.mjs';
import { YEAR, beyondYear, stripSrcPrefix } from '../../../lib/kalendar';
import { yazyk, razobratPut, stroka, chislo, strelkaVpered, strelkaNazad } from '../../../lib/yazyki.mjs';
export async function getStaticPaths() {
  const days = await getCollection('days');
  return (await getCollection('museums'))
    .filter((m) => days.some((d) => d.data.museum === m.data.slug))
    .map((m) => ({ params: { slug: m.data.slug }, props: { m: m.data, days: days.filter((d) => d.data.museum === m.data.slug) } }));
}
const { m, days } = Astro.props;
// Картинка пересылки без обложки музея — первая настоящая растровая картинка дней (Base.astro, ogFallback).
const ogFallback = [...days].sort((a, b) => a.data.key.localeCompare(b.data.key)).flatMap((d) => d.data.images ?? [])
  .filter((i) => !i.generated).map((i) => ogRaster(i.src)).find(Boolean); // WebP — JPG/PNG-двойником (Б9 19.10)
const base = import.meta.env.BASE_URL;
// Строки подвала — по языку страницы (Г20, src/data/stroki.json); русский вывод не меняется.
const lang = yazyk(razobratPut(Astro.url.pathname, base).code);
const s = (key: string): any => stroka(lang.code, key);
const zapisey = (n: number) => chislo(lang.code, n, 'zapisFormy');
// Состав карточки — как у старого календаря этого музея: механика и источник только там, где они
// были (поле card в calendar-meta); отображение «запись → календарь» — src/lib/kalendar-dannye.mjs (и для полных страниц).
const { cal, conf } = kalendarMuzeya(m.slug, days.map((d) => d.data), base);
// Сетка года и карточка дня — уже в вёрстке, той же разметкой, что строит движок (museum-calendar-page.js, стр. 36–185):
// движок по DOMContentLoaded заменяет её такой же, и страница не перескакивает после первого кадра (CLS, O1 16.10).
// Отличие только в «сегодня»: его движок считает по дате посетителя; здесь — дата сборки по Москве.
type Day = { t: string; y?: number; d: string; mech?: string; src?: string; href: string; link: string };
// названия месяцев — из словаря языка (Г20); в сетке — с заглавной, в дате — родительный падеж
const MON: string[] = s('mesyacy').map((x: string) => x.charAt(0).toUpperCase() + x.slice(1));
const MONR: string[] = s('mesyacyR');
const pad = (n: number) => (n < 10 ? '0' : '') + n;
const data: Record<string, Day> = Object.fromEntries(Object.entries(cal).filter(([k]) => /^\d{2}-\d{2}$/.test(k))) as Record<string, Day>;
const dated = conf.dated !== false;
const total = dated ? (conf.total || 365) : 365;
const [ty, tm, td] = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Moscow' }).format(new Date()).split('-').map(Number);
const tk = pad(tm) + '-' + pad(td);
// февраль — по ближайшему февралю вперёд (2027 не високосный — 28), запись 02-29 есть — 29; как в museum-calendar-page.js
const febYear = ty + (tm > 2 ? 1 : 0);
const leap = (y: number) => (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;
const DAYS = [31, leap(febYear) || data['02-29'] ? 29 : 28, 31,30,31,30,31,31,30,31,30,31];
const mLen: number[] = dated ? (conf.months?.length === 12 ? conf.months : DAYS) : YEAR;
const allKeys = Object.keys(data).sort();
const beyond = allKeys.filter((k) => beyondYear(k, dated));
const filled = allKeys.length - beyond.length;
const months = MON.map((name, i) => {
  const cells = Array.from({ length: mLen[i] }, (_, j) => {
    const k = pad(i + 1) + '-' + pad(j + 1), it = data[k];
    let lbl = it ? it.t : s('zapisGotovitsya');
    if (!dated) lbl = s('denN').replace('{n}', String(j + 1)) + (it ? ' — ' + it.t : '');
    return { d: j + 1, k: it ? k : undefined, today: dated && k === tk, title: lbl.replace(/"/g, '') };
  });
  const cnt = cells.filter((c) => c.k).length;
  return { name, cnt: cnt ? cnt + ' ' + zapisey(cnt) : '—', cells };
});
const extra = beyond.map((k) => ({ k, dd: +k.slice(3), mon: MON[+k.slice(0, 2) - 1], t: data[k].t }));
// какой день движок откроет первым: сегодняшний, иначе ближайший вперёд по кругу года; у недатированного — первый
const ahead = (k: string) => {
  const t = Date.UTC(ty, tm - 1, td); let d = Date.UTC(ty, +k.slice(0, 2) - 1, +k.slice(3));
  if (d < t) d = Date.UTC(ty + 1, +k.slice(0, 2) - 1, +k.slice(3));
  return Math.round((d - t) / 86400000);
};
let open: string | undefined, note = '';
if (!dated) open = allKeys[0];
else if (data[tk]) open = tk;
else if (allKeys.length) {
  open = allKeys.reduce((a, k) => (ahead(k) < ahead(a) ? k : a), allKeys[0]);
  note = s('blizhayshayaZapis').replace('{n}', String(ahead(open))).replace('{dney}', chislo(lang.code, ahead(open), 'dneyFormy'));
}
const it = open ? data[open] : undefined;
const when = open && (dated ? +open.slice(3) + ' ' + MONR[+open.slice(0, 2) - 1] + (open === tk ? ' · <b>' + s('segodnyaMal') + '</b>' : '')
  : s('denMesyac').replace('{d}', String(+open.slice(3))).replace('{m}', MON[+open.slice(0, 2) - 1]));
// подпись строки уже есть — префикс «Источник(и):» из данных не дублируем (17.10), как в museum-calendar-page.js
const row = (label: string, v?: string) => { const t = stripSrcPrefix(v); return t ? `<div class="crow"><span class="crow-l">${label}</span>${t}</div>` : ''; };
const cardHtml = it ? '<div class="cdate">' + (note ? note + ' · ' : '') + when + '</div>' +
  '<h3>' + it.t + (it.y ? ' <span class="caly">' + it.y + '</span>' : '') + '</h3>' +
  '<p>' + it.d + '</p>' + row(s('mehanika'), it.mech) + row(s('istochnik'), it.src) +
  (it.href ? '<a href="' + it.href + '">' + (it.link || s('otkryt') + ' ' + strelkaVpered(lang.dir)) + '</a>' : '') : '';
---
<Base title={s('kalTitle').replace('{t}', m.title_ru)} description={s('kalOpisanie').replace('{t}', m.title_ru)} museum={m.slug} museumTitle={m.title_ru} here={s('kalZdes')} ogFallback={ogFallback}>
  <header slot="header"><div class="b1">{m.title_ru}</div><h1>{s('kalH1')}</h1></header>
  <div class="cal-supslot" data-support-slot></div>
  <div id="calcard" set:html={cardHtml}></div>
  <div id="calyear"><div class="calstat">{s('zapolnenoDney')} <b>{filled}</b> {s('iz')} {total} {beyond.length > 0 && ` · ${s('sverhGodaEshche').replace('{n}', String(beyond.length)).replace('{zapisey}', zapisey(beyond.length))}`}</div>{months.map((mo) => (
    <section class="cmon"><h2>{mo.name}<span class="cnt">{mo.cnt}</span></h2><div class="cgrid">{mo.cells.map((c) => (
      c.k && data[c.k].href
        ? <a class:list={['cday', { full: true, today: c.today, on: c.k === open }]} href={data[c.k].href} data-k={c.k} title={c.title}>{c.d}</a>
        : <button class:list={['cday', { full: c.k, today: c.today, on: c.k && c.k === open }]} data-k={c.k} disabled={!c.k} title={c.title}>{c.d}</button>))}</div></section>))}{extra.length > 0 && (
    <section class="cmon beyond"><h2>{s('sverhGoda')}<span class="cnt">{extra.length} {zapisey(extra.length)}</span></h2><div class="cgrid cgrid-wide">{extra.map((x) => (
      data[x.k].href
        ? <a class="cday full cextra" href={data[x.k].href} data-k={x.k} title={`${s('denMesyac').replace('{d}', String(x.dd)).replace('{m}', x.mon)} — ${x.t}`.replace(/"/g, '')}>{x.dd} · {x.mon}</a>
        : <button class="cday full cextra" data-k={x.k} title={`${s('denMesyac').replace('{d}', String(x.dd)).replace('{m}', x.mon)} — ${x.t}`.replace(/"/g, '')}>{x.dd} · {x.mon}</button>))}</div></section>)}</div>
  <div class="council"><b style="color:var(--gold-l)">{s('kalNapolnyaetsya')}</b> {s('kalSostav')}</div>
  <Fragment slot="footer"><a href={`${base}muzei/${m.slug}/`}>{`${strelkaNazad(lang.dir)} ${s('vMuzey')}`}</a> · <a href={base}>{`${s('vGorod')} ${strelkaVpered(lang.dir)}`}</a></Fragment>
  <script is:inline define:vars={{ cal }}>window.MUSEUM_CALENDAR = cal;</script>
  <script is:inline src={`${base}assets/museum-calendar-page.js`}></script>
  <script is:inline define:vars={{ support: { museum: m.title_ru } }}>window.MUSEUM_SUPPORT = support;</script>
  <script is:inline src={`${base}assets/museum-support.js`}></script>
</Base>
