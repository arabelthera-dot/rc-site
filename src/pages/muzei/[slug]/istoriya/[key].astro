---
// «История дня» для телефона (п.503, Р745): страница дня экранами во всю высоту, листать пальцем — CSS scroll-snap,
// без библиотек. Экраны — из той же карточки дня (src/lib/istoriya.mjs): обложка, хук, факты по одному, игра в конце.
// Выключено: без PUBLIC_ISTORIYA=1 страниц нет вовсе (getStaticPaths пуст). На пробе — noindex.
import { kartochki } from '../../../../lib/dni-shablon.mjs';
import { istoriyaOn, ekrany } from '../../../../lib/istoriya.mjs';
export async function getStaticPaths() {
  if (!istoriyaOn()) return [];
  const museums = JSON.parse((await import('node:fs')).readFileSync('src/data/museums.json', 'utf8'));
  const spisok = museums.museums;
  return kartochki().filter((k) => k.adres === 'den').map((d) => ({ params: { slug: d.muzei, key: d.key },
    props: { d, muzeyName: spisok.find((m) => m.slug === d.muzei)?.title_ru ?? '' } }));
}
const { d, muzeyName } = Astro.props;
const base = import.meta.env.BASE_URL;
const MES = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'];
const kogda = `${parseInt(d.key.slice(3))} ${MES[parseInt(d.key.slice(0, 2)) - 1]}`;
const den = `${base}muzei/${d.muzei}/den/${d.key}/`;
const ek = ekrany(d, base);
---
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex">
<title>{`История дня · ${kogda} · ${muzeyName}`}</title>
<link rel="canonical" href={new URL(den, Astro.site).href}>
<style is:inline>
html,body{margin:0;height:100%;background:#111;color:#fff;font:18px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
.ist{height:100dvh;overflow-y:auto;scroll-snap-type:y mandatory;overscroll-behavior-y:contain}
.ek{height:100dvh;scroll-snap-align:start;scroll-snap-stop:always;box-sizing:border-box;padding:max(24px,env(safe-area-inset-top)) 22px max(28px,env(safe-area-inset-bottom));display:flex;flex-direction:column;justify-content:center;position:relative}
.ek-ob{justify-content:flex-end;background:#000}
.ek-ob img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;opacity:.75}
.ek-ob .tx{position:relative;background:linear-gradient(transparent,rgba(0,0,0,.85) 30%);padding-top:40px;margin:0 -22px -28px;padding:40px 22px 56px}
.kick{font-size:.8em;letter-spacing:.04em;text-transform:uppercase;opacity:.75;margin:0 0 .6em}
h1{font-size:1.6em;line-height:1.2;margin:0 0 .3em}
.hook{font-size:1.35em;line-height:1.35}
.fakt{font-size:1.25em}
.ek:nth-child(even){background:#1b2433}
.btn{display:block;text-align:center;background:#fff;color:#111;border-radius:12px;padding:14px;margin:10px 0;text-decoration:none;font-weight:600;min-height:24px}
.btn2{background:transparent;color:#fff;border:2px solid #fff}
.dal{position:absolute;bottom:max(10px,env(safe-area-inset-bottom));left:0;right:0;text-align:center;font-size:.8em;opacity:.6}
.top{position:fixed;top:max(8px,env(safe-area-inset-top));right:12px;z-index:2;color:#fff;font-size:.85em;background:rgba(0,0,0,.5);padding:6px 10px;border-radius:8px;text-decoration:none}
</style>
</head>
<body>
<a class="top" href={den}>Страница дня ✕</a>
<main class="ist" aria-label="История дня, листайте вверх">
{ek.map((e) => (
  e.vid === 'oblozhka' ? <section class="ek ek-ob">{e.img && <img src={e.img.src} alt={e.img.alt} width={e.img.w} height={e.img.h} decoding="async">}
    <div class="tx"><p class="kick">{kogda}{e.god ? ` ${e.god}` : ''} · {muzeyName}</p><h1>{e.zag}</h1></div><p class="dal">листай вверх ↑</p></section>
  : e.vid === 'hook' ? <section class="ek"><p class="hook">{e.tekst}</p></section>
  : e.vid === 'fakt' ? <section class="ek"><p class="kick">Факт {e.n} из {e.vsego}</p><p class="fakt">{e.tekst}</p></section>
  : <section class="ek"><p class="kick">В конце — игра</p><h1>Проверь себя</h1>
    <a class="btn" href={`${den}#games`}>Игра дня</a>{e.est && <a class="btn btn2" href={`${den}#quiz`}>Викторина дня</a>}
    <a class="btn btn2" href={den}>Вся страница дня</a></section>
))}
</main>
</body>
</html>
