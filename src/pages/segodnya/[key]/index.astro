---
// «Этот день во всех музеях» (Р286 п.2, 27.10.2026): /segodnya/<ММ-ДД>/ — готовые дни этой даты во всех музеях,
// по номеру музея. Адрес — рядом с данными блока «Сегодня» (segodnya/<ММ-ДД>.json): та же дата, тот же раздел.
// Страница — только у даты, где готов хотя бы один день (src/lib/etot-den.mjs); пустых дат и пустых карточек нет,
// соседи «←/→» — ближайшие такие же даты по кругу года. Вид — public/assets/rc-etot-den.css.
import Base from '../../../layouts/Base.astro';
import InlineCss from '../../../components/InlineCss.astro';
import { gotovyeDni, datyUzlov, kogda, adresUzla, adresDnya } from '../../../lib/etot-den.mjs';
import { plural } from '../../../lib/kalendar';
export function getStaticPaths() {
  const daty = datyUzlov();
  return daty.map((key, i) => ({ params: { key }, props: { prev: daty[(i - 1 + daty.length) % daty.length], next: daty[(i + 1) % daty.length] } }));
}
const { key } = Astro.params;
const { prev, next } = Astro.props;
const base = import.meta.env.BASE_URL;
const dni = gotovyeDni().get(key!)!;
const when = kogda(key!);
const src = (s: string) => (/^https?:/.test(s) ? s : `${base}${s.replace(/^\//, '')}`);
// Вход — «афиша дня»: дата крупно и одна фраза в полный голос — хук первого по номеру музея (№1 — первенства).
// Его день — главная карточка, хук над ней не повторяется; остальные — сетка, ровная при любом числе (вид — CSS по data-n).
const [glav, ...ostal] = dni;
const skolko = dni.length === 1
  ? `Пока ${when} готов один музей портала — другие появятся здесь сами`
  : `${dni.length} ${plural(dni.length, 'музей', 'музея', 'музеев')} портала — ${dni.length} ${plural(dni.length, 'история', 'истории', 'историй')} одного дня`;
const vnutri = (d: { vnutri: string[] }) => (d.vnutri.length ? `внутри: ${d.vnutri.join(' · ')}` : '');
const daty = datyUzlov();
---
<Base title={`${when} во всех музеях · Русская цивилизация`} description={`Этот день во всех музеях «Русской цивилизации»: ${dni.map((d) => d.title).join('; ')}.`.slice(0, 300)} schema="page" image={dni.find((d) => d.img)?.img && src(dni.find((d) => d.img)!.img!)} crumbs={[{ label: `${when} во всех музеях` }]}>
  <Fragment slot="head"><InlineCss file="rc-etot-den.css" /></Fragment>
  <div class="rc-uzel">
    <header class="rc-uzel-head">
      <p class="rc-uzel-kicker">Этот день во всех музеях</p>
      <h1 class="rc-uzel-data">{when}</h1>
      {glav.hook && <p class="rc-uzel-hook-dnya">{glav.hook}</p>}
      <p class="rc-uzel-skolko">{skolko}</p>
    </header>
    <a class="rc-uzel-card rc-uzel-glav" href={adresDnya(base, glav.museum, glav.key)}>
      {glav.img && <span class="rc-uzel-kadr"><img src={src(glav.img)} alt={glav.alt ?? ''} decoding="async" fetchpriority="high" width="960" height="600" /></span>}
      <span class="rc-uzel-body">
        <span class="rc-uzel-muzey">{glav.museumTitle}</span>
        <span class="rc-uzel-title">{glav.title}</span>
        {(glav.year || vnutri(glav)) && <span class="rc-uzel-meta">{glav.year && <span class="rc-uzel-god">{glav.year}</span>}{vnutri(glav) && <span>{vnutri(glav)}</span>}</span>}
        <span class="rc-uzel-otkryt">Открыть день <span aria-hidden="true">→</span></span>
      </span>
    </a>
    {ostal.length > 0 && <ul class="rc-uzel-list" data-n={ostal.length}>
      {ostal.map((d) => (
        <li><a class="rc-uzel-card" href={adresDnya(base, d.museum, d.key)}>
          {d.img ? <span class="rc-uzel-kadr"><img src={src(d.img)} alt={d.alt ?? ''} loading="lazy" decoding="async" width="640" height="400" /></span>
            : <span class="rc-uzel-kadr rc-uzel-bez" aria-hidden="true">{d.year ?? when}</span>}
          <span class="rc-uzel-body">
            <span class="rc-uzel-muzey">{d.museumTitle}</span>
            <span class="rc-uzel-title">{d.title}</span>
            {d.hook && <span class="rc-uzel-hook">{d.hook}</span>}
            {(d.year || vnutri(d)) && <span class="rc-uzel-meta">{d.year && <span class="rc-uzel-god">{d.year}</span>}{vnutri(d) && <span>{vnutri(d)}</span>}</span>}
            <span class="rc-uzel-otkryt">Открыть день <span aria-hidden="true">→</span></span>
          </span>
        </a></li>))}
    </ul>}
    {daty.length > 1 && <nav class="rc-uzel-nav" aria-label="Соседние даты">
      <a href={adresUzla(base, prev)} rel="prev">← {kogda(prev)}</a>
      <a href={`${base}segodnya/`}>Все даты</a>
      <a href={adresUzla(base, next)} rel="next">{kogda(next)} →</a>
    </nav>}
  </div>
</Base>
