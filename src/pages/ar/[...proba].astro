---
// Г20 (план сайта): проба письма справа налево — одна арабская страница-заглушка /ar/ на общем шаблоне Base.astro.
// ВЫКЛЮЧЕНА по умолчанию: собирается только при RC_PROBA_RTL=1 (обычная сборка её не создаёт вовсе).
// noindex, в карту сайта не идёт (фильтр в astro.config.mjs); арабский в yazyki.json — ready:false, поэтому
// в hreflang и переключателе языков его нет. lang="ar" dir="rtl" Base.astro берёт из приставки адреса /ar/.
// Откат — удалить этот файл и строку фильтра /ar/ в astro.config.mjs.
import Base from '../../layouts/Base.astro';
export function getStaticPaths() {
  return process.env.RC_PROBA_RTL === '1' ? [{ params: { proba: undefined } }] : [];
}
const base = import.meta.env.BASE_URL;
---
<Base title="الحضارة الروسية — صفحة تجريبية" description="صفحة تجريبية للكتابة من اليمين إلى اليسار." noindex
      museum="izobreteniya" museumTitle="متحف «ما اخترعه الروس أولاً في العالم»" here="صفحة تجريبية" schema="page">
  <header slot="header" style="max-width:720px;margin:0 auto;padding:24px 16px 0">
    <h1>الحضارة الروسية</h1>
    <p>هذه صفحة تجريبية. نتحقق من أن القالب يعمل بالكتابة من اليمين إلى اليسار: الشريط العلوي، والنص، والتذييل.</p>
  </header>
  <section style="max-width:720px;margin:0 auto;padding:0 16px 24px">
    <p>أول جهاز راديو، وأول قمر صناعي، وأول إنسان في الفضاء — هذه بعض الاختراعات التي قدمتها روسيا للعالم قبل الجميع.</p>
    <ul><li>عنصر أول في القائمة</li><li>عنصر ثانٍ في القائمة — 1957</li></ul>
    <p><a href={base}>← العودة إلى الصفحة الرئيسية (بالروسية)</a></p>
  </section>
</Base>
