---
// Служебная (для помощников, карта стандарта) — noindex, вне карты сайта (Е6, src/integrations/karta-volnami.mjs).
import Base from '../layouts/Base.astro';
---
<Base title="Карта стандарта · Русская цивилизация" description="Из чего состоит каждая страница музеев «Русской цивилизации»." crumbs={[{ label: 'Карта стандарта' }]} noindex>
  <header slot="header"><div class="b1">Новый сайт</div><h1>Карта стандарта</h1><p>Что у нас было — и чем это становится в общепринятом устройстве сайта</p></header>
  <div class="karta">
    <h2>Суть в трёх строках</h2>
    <ul>
      <li>Каждый день музея — <b>одна карточка с данными</b> (название, хук, источник, картинки, механика). Страницы собираются из карточек сами.</li>
      <li>Правила страницы (хук одной фразой, русский источник, полное имя музея; у картинки подпись и источник, текста на картинке нет, сгенерированное помечено) проверяет <b>сама сборка</b>: нарушил — сайт не собирается, отдельные сторожа не нужны.</li>
      <li>Интерактивы и движки остаются как есть — они встраиваются в страницу «островками».</li>
    </ul>
    <h2>Было → стало</h2>
    <table>
      <tr><th>Было</th><th>Стало</th></tr>
      <tr><td>836 html-файлов, каждый правится руками</td><td>Карточки дней + 4 шаблона (главная, музей, календарь, день)</td></tr>
      <tr><td>Данные календаря внутри js-файла музея</td><td>Те же данные — карточкой на каждый день; календарь собирается из них</td></tr>
      <tr><td>Около двухсот служебных скриптов-сторожей</td><td>Схема карточки + одна проверка сборки (цель — не больше 15 скриптов)</td></tr>
      <tr><td>Стили в каждой странице</td><td>Один общий файл стилей на весь сайт</td></tr>
      <tr><td>Движки assets/*.js</td><td>Те же движки, без переделки</td></tr>
      <tr><td>Своё слияние и наряды</td><td>Обычная заявка на GitHub с автослиянием после зелёной проверки</td></tr>
    </table>
    <h2>Где что лежит</h2>
    <ul>
      <li>Каталог музеев — тот же список, полное имя музея берётся только оттуда.</li>
      <li>Дни — папка на каждый музей, файл на каждый день.</li>
      <li>Шаблоны страниц делают помощники-дизайнеры по стандартам музейных скиллов; содержание скиллов не меняется.</li>
    </ul>
    <h2>Что уже работает</h2>
    <p>Музей стойкости и подвига «Русские не сдаются»: все 376 дней перенесены карточками, календарь — тем же движком, у каждого дня своя страница. Остальные музеи — витрины; их дни переезжают на шаге переноса.</p>
    <h2>Дальше по плану</h2>
    <p>Паспорт дня с машинными правилами — 17.10; шаблоны по стандарту музеев — 19.10; перенос всех страниц со сверкой снимками — 22.10; переключение адреса — 23.10.</p>
  </div>
</Base>
