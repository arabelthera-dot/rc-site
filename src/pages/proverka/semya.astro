---
// Задание семье с ребёнком 6–10 лет (Р46): ребёнок ведёт сам, взрослый молча смотрит и записывает.
// Разметка — src/components/Proverka.astro. Сказка — готовая страница «Василиса Прекрасная» (skazki 01-01, знак 0+).
import Proverka from '../../components/Proverka.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const muzej = (await getCollection('museums')).map((m) => m.data).find((m) => m.slug === 'skazki')!;
const skazka = `${base}muzei/skazki/den/01-01/`;
const shagi = [
  { min: 2, h: 'Главная — ребёнок сам', href: base, link: 'Открыть главную', delat: [
    'Дайте ребёнку телефон или мышь и ничего не подсказывайте.',
    'Спросите: «Как думаешь, что это за сайт?» Запишите ответ дословно.'] },
  { min: 2, h: 'Детский вход', href: `${base}detyam/`, link: 'Открыть страницу «Детям»', delat: [
    'Попросите выбрать то, что ему самому хочется открыть.',
    'Посмотрите, куда он нажимает первым и долго ли ищет.'] },
  { min: 4, h: 'Одна сказка', href: skazka, link: `${muzej.title_ru} — «Василиса Прекрасная»`, delat: [
    'Пусть читает или слушает сам. Если просит помочь — помогите и запишите, с чем.',
    'Заметьте, где он заскучал, отвлёкся или стал листать быстро.'] },
  { min: 2, h: 'Игра', href: `${skazka}#games`, link: 'Вопросы и игра на той же странице', delat: [
    'Пусть попробует сам. Понял ли без вас, что нажимать?',
    'Что он сказал вслух, когда получилось или не получилось?'] },
];
---
<Proverka
  title="Проверка сайта с ребёнком"
  lead="10 минут для ребёнка 6–10 лет и одного взрослого. Главное правило: ребёнок ведёт сам, взрослый не подсказывает, а смотрит и записывает. Где ребёнок застрял — там ошибка сайта, а не его."
  drugoy={{ href: `${base}proverka/`, label: 'Проверяете один, без ребёнка? Вам — это задание →' }}
  shagi={shagi}
  zamechat={[
    'Куда ребёнок нажал первым — и туда ли, куда мы задумали.',
    'Слова, которые он не понял или переспросил.',
    'Где позвал взрослого на помощь.',
    'Где заскучал или захотел уйти — и где, наоборот, оживился.',
  ]}
  voprosy={[
    'Ребёнку: что тебе больше всего запомнилось?',
    'Ребёнку: где было непонятно, что нажать или что делать?',
    'Ребёнку: хочешь завтра открыть ещё одну сказку? Почему?',
    'Взрослому: где ребёнку понадобилась ваша помощь и с чем?',
    'Взрослому: было ли на страницах то, что вы не хотели бы показывать ребёнку этого возраста?',
  ]}
  tema="Проверка сайта — семья"
  pro="Возраст ребёнка (только возраст, без имени):
Чем открывали (телефон, планшет или компьютер):"
/>
