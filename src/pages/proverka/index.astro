---
// Задание проверяющему-взрослому (Р46). Разметка — src/components/Proverka.astro; семейный вариант — semya.astro.
// День с интерактивом — готовая страница «Шухов, нефтепровод» (izobreteniya 01-05); имя музея — title_ru полностью.
import Proverka from '../../components/Proverka.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const muzej = (await getCollection('museums')).map((m) => m.data).find((m) => m.slug === 'izobreteniya')!;
const den = `${base}muzei/izobreteniya/den/01-05/`;
const shagi = [
  { min: 2, h: 'Главная', href: base, link: 'Открыть главную', delat: [
    'Не читайте подробно — просто посмотрите первый экран.',
    'Через 10 секунд закройте глаза и скажите вслух: что это за сайт и что здесь можно делать?',
    'Пролистайте до конца. Есть ли место, куда захотелось нажать?'] },
  { min: 4, h: 'Один день музея', href: den, link: `${muzej.title_ru} — 5 января`, delat: [
    'Прочитайте рассказ дня так, как читали бы дома, — не торопясь.',
    'Если бросили читать — запомните, на каком месте и почему.',
    'Долистайте до конца страницы: где источники, куда предлагают пойти дальше.'] },
  { min: 2, h: 'Игра дня', href: `${den}#games`, link: 'Игра и вопросы на той же странице', delat: [
    'Попробуйте пройти игру, не читая подсказок заранее.',
    'Понятно ли сразу, что нажимать? Где пришлось угадывать?'] },
  { min: 2, h: 'Детский вход', href: `${base}detyam/`, link: 'Открыть страницу «Детям»', delat: [
    'Представьте ребёнка 7–10 лет. Нашёл бы он здесь, что открыть, без вашей помощи?',
    'Откройте одну сказку и посмотрите только первый экран.'] },
];
---
<Proverka
  title="Проверка сайта до запуска"
  lead="Спасибо, что согласились. Это займёт 10 минут. Проверяем не вас, а сайт: всё, где вы запнулись, — наша ошибка, и её важно найти до запуска. Лучше с телефона — так его откроет большинство."
  drugoy={{ href: `${base}proverka/semya/`, label: 'Будете проверять вместе с ребёнком? Вам — другое задание →' }}
  shagi={shagi}
  zamechat={[
    'Где пришлось перечитать или не поняли слово.',
    'Что не нажалось, долго грузилось или съехало на экране.',
    'Где засомневались в факте, дате или имени.',
    'Где стало скучно и захотелось закрыть страницу.',
  ]}
  voprosy={[
    'Что это за сайт — одной фразой, своими словами?',
    'Где вы запнулись или не поняли, что делать дальше?',
    'Дочитали ли рассказ дня до конца? Если нет — на каком месте бросили?',
    'Что не сработало или выглядело странно (на каком телефоне или компьютере)?',
    'Вернулись бы сюда завтра? Кому бы показали — и почему?',
  ]}
  tema="Проверка сайта — взрослый"
  pro="Чем открывали (телефон или компьютер, какой):"
/>
