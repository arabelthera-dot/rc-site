---
// Главная портала: шапка (текст Сергея дословно) → «Найти день по дате» → «Сегодня» (3 карточки, остальные по кнопке) → «Поддержать проект» → витрина музеев → подвал.
// Вид — только public/assets/portal.css. Поддержка — движок museum-support.js: главный блок встаёт
// в размеченный слот [data-support-slot], дубль движок сам ставит перед подвалом, сердечко — тоже он.
import Base from '../layouts/Base.astro';
import InlineCss from '../components/InlineCss.astro';
import '../styles/portal-base.css';
import Segodnya from '../components/portal/Segodnya.astro';
import DenPoDate from '../components/portal/DenPoDate.astro';
import SegodnyaVse from '../components/portal/SegodnyaVse.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import { beyondYear, isDated } from '../lib/kalendar';
import { yazyk, razobratPut, stroka, chislo, strelkaVpered } from '../lib/yazyki.mjs';
const base = import.meta.env.BASE_URL;
// строки главной — по языку страницы (Г20, src/data/stroki.json); русский вывод не меняется
const lang = yazyk(razobratPut(Astro.url.pathname, base).code);
const s = (key: string): any => stroka(lang.code, key);
const museums = (await getCollection('museums')).sort((a, b) => a.data.number - b.data.number);
const days = await getCollection('days');
// в счётчик — только дни года, записи «сверх года» не считаются (как на странице календаря)
const count = (slug: string) => { const dated = isDated(slug); return days.filter((d) => d.data.museum === slug && !beyondYear(d.data.key, dated)).length; };
// ссылка — только на страницы, которые реально собираются: src/pages/muzei/[slug]/index.astro
// строит адрес для каждого музея из коллекции museums (getStaticPaths), других страниц музея нет
const built = new Set(museums.map((m) => m.data.slug));
const cards = museums
  .map((m) => ({ ...m.data, n: count(m.data.slug),
    // обложки старого сайта (og/<slug>_index.jpg) несут зашитую надпись — текст на картинке запрещён (03.08), в витрине не берём
    cover: null as string | null,
    href: built.has(m.data.slug) ? `${base}muzei/${m.data.slug}/` : null }))
  // музеи с календарём — выше, внутри групп — по номеру
  .sort((a, b) => (b.n > 0 ? 1 : 0) - (a.n > 0 ? 1 : 0) || a.number - b.number);
let eager = 2; // первые обложки — без ленивой загрузки
const support = { museum: s('portalImya'), lang: lang.code };
---
<Base portal schema="home" title={s('portalTitle')} ogTitle={s('portalImya')} image={`${base}og/index.jpg`} description={s('portalOpisanie')}>
  <Fragment slot="head">
    {/* только шрифты главной (#2004 п.6); кириллица Inter и Playfair — заранее: ими набран первый экран */}
    <link rel="preload" href={`${base}assets/fonts/inter-UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa0ZL7SUc.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}assets/fonts/playfairdisplay-nuFiD-vYSZviVYUb_rj3ij__anPXDTjYgFE_.woff2`} as="font" type="font/woff2" crossorigin />
    {/* стили первого экрана — внутрь <head>, без блокирующих запросов (render-blocking, 18.10) */}
    <InlineCss file="fonts-portal.css" />
    <InlineCss file="portal.css" />
  </Fragment>
  <header slot="header" class="p-hero">
    <div class="p-orn" aria-hidden="true"><span></span><i>✦</i><span></span></div>
    <h1>{s('portalImya')}</h1>
    <p class="p-lead">{s('portalLead')}</p>
    <p class="p-sub">{s('portalSub')}</p>
    <div class="p-orn p-orn-b" aria-hidden="true"><span></span><i>✦</i><span></span></div>
  </header>

  <div class="p-wrap">
    <DenPoDate />
    <Segodnya />
    <SegodnyaVse />

    <div class="p-supslot" data-support-slot></div>

    <section class="p-vitrina" aria-labelledby="p-vit-h">
      <h2 id="p-vit-h" class="p-sec">{s('muzei')}</h2>
      <ul class="p-grid">
        {cards.map((c) => {
          const Tag = c.href ? 'a' : 'div';
          const lazy = c.cover ? (eager-- > 0 ? 'eager' : 'lazy') : undefined;
          return (
            <li class:list={['p-card', c.cover ? 'has-cover' : 'is-type', c.n > 0 && 'has-cal']}>
              <Tag class="p-in" {...(c.href ? { href: c.href } : {})}>
                {c.cover
                  ? <img class="p-cover" src={c.cover} alt="" width="1200" height="630" loading={lazy} decoding="async" />
                  : <div class="p-plate" aria-hidden="true"><span class="p-no">№&nbsp;{c.number}</span></div>}
                <div class="p-body">
                  <h3>{c.title_ru}</h3>
                  {c.promise_ru && <p>{c.promise_ru}</p>}
                  {c.n > 0 && <div class="p-st">{s('vKalendare').replace('{n}', String(c.n)).replace('{dney}', chislo(lang.code, c.n, 'dneyFormy'))}</div>}
                  {c.href && <span class="p-go" aria-hidden="true">{`${s('voytiVMuzey')} ${strelkaVpered(lang.dir)}`}</span>}
                </div>
              </Tag>
            </li>
          );
        })}
      </ul>
    </section>
  </div>

  <script is:inline define:vars={{ support }}>window.MUSEUM_SUPPORT = support;</script>
  <script is:inline src={`${base}assets/museum-support.js`} defer></script>

  <Fragment slot="footer"><p class="p-park">{s('portalPark')}</p></Fragment>
</Base>
