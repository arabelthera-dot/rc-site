---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const museums = (await getCollection('museums')).sort((a, b) => a.data.number - b.data.number);
const days = await getCollection('days');
const count = (slug: string) => days.filter((d) => d.data.museum === slug).length;
---
<Base title="Русская цивилизация — город-музей" image={`${import.meta.env.BASE_URL}og/index.jpg`} description="Виртуальный город-музей достижений России: музеи на каждый день года.">
  <header slot="header"><div class="b1">Русская цивилизация</div><h1>Город-музей</h1><p>{museums.length} музеев · каркас нового сайта</p></header>
  <div class="mlist">
    {museums.map((m) => (
      <a class="mcard" href={`${base}muzei/${m.data.slug}/`}>
        <div class="num">№ {m.data.number}</div>
        <h2>{m.data.title_ru}</h2>
        {m.data.promise_ru && <p>{m.data.promise_ru}</p>}
        {count(m.data.slug) > 0 && <div class="st">в календаре: {count(m.data.slug)} дней</div>}
      </a>
    ))}
  </div>
</Base>
