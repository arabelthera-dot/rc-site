---
// Главная портала: шапка (текст Сергея дословно) → «Сегодня»: вещь дня → «Найти день по дате» → ещё сегодня (3 карточки, остальные по кнопке) → «Поддержать проект» → витрина музеев → подвал.
// Вид — только public/assets/portal.css. Поддержка — движок museum-support.js: главный блок встаёт
// в размеченный слот [data-support-slot], дубль движок сам ставит перед подвалом, сердечко — тоже он.
import Base from '../layouts/Base.astro';
import InlineCss from '../components/InlineCss.astro';
import '../styles/portal-base.css';
import Segodnya from '../components/portal/Segodnya.astro';
import DenPoDate from '../components/portal/DenPoDate.astro';
import SegodnyaVse from '../components/portal/SegodnyaVse.astro';
import Vitrina from '../components/portal/Vitrina.astro';
import { yazyk, razobratPut, stroka } from '../lib/yazyki.mjs';
import { ogSegodnya } from '../lib/og-segodnya';
const base = import.meta.env.BASE_URL;
// «Поддержать проект» — выключено до работающего приёма денег (Р31, 20.10.2026); включение — PUBLIC_PODDERZHKA=1.
const podderzhka = import.meta.env.PUBLIC_PODDERZHKA === '1';
// строки главной — по языку страницы (Г20, src/data/stroki.json); русский вывод не меняется
const lang = yazyk(razobratPut(Astro.url.pathname, base).code);
const s = (key: string): any => stroka(lang.code, key);
const support = { museum: s('portalImya'), lang: lang.code };
// Паспорт пересылки главной — «вещь дня» на московскую дату сборки (20.10.2026, src/lib/og-segodnya.ts):
// заголовок и хук — только в og:title/og:description, картинка — сам кадр (1200×630, без текста); нет кадра — общая.
const og = await ogSegodnya(lang.code);
---
<Base portal schema="home" title={s('portalTitle')} ogTitle={og.title ?? s('portalImya')} image={og.file ? `${base}og/segodnya-${og.key}.jpg` : `${base}og/og-default.jpg`} imageAlt={og.file ? og.alt : undefined} description={s('portalOpisanie')} ogDescription={og.description}>
  <Fragment slot="head">
    {/* только шрифты главной (#2004 п.6); кириллица Inter и Playfair — заранее: ими набран первый экран */}
    <link rel="preload" href={`${base}assets/fonts/inter-UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa0ZL7SUc.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}assets/fonts/playfairdisplay-nuFiD-vYSZviVYUb_rj3ij__anPXDTjYgFE_.woff2`} as="font" type="font/woff2" crossorigin />
    {/* стили первого экрана — внутрь <head>, без блокирующих запросов (render-blocking, 18.10) */}
    <InlineCss file="fonts-portal.css" />
    <InlineCss file="portal.css" />
  </Fragment>
  <header slot="header" class="p-hero">
    <div class="p-orn" aria-hidden="true"><span></span><i>✦</i><span></span></div>
    <h1>{s('portalImya')}</h1>
    <p class="p-lead">{s('portalLead')}</p>
    <p class="p-sub">{s('portalSub')}</p>
    {/* Детский вход (Р41, Е3, 20.10) — только ссылка */}
    <p class="p-detyam"><a href={`${base}detyam/`}>Детям — сказки и истории для детей →</a></p>
    <div class="p-orn p-orn-b" aria-hidden="true"><span></span><i>✦</i><span></span></div>
  </header>

  <div class="p-wrap">
    {/* первый экран — «вещь дня» (Е7, 20.10), под ней «День по дате», затем остальные музеи этой даты */}
    <Segodnya><DenPoDate /></Segodnya>
    <SegodnyaVse />

    {podderzhka && <div class="p-supslot" data-support-slot></div>}

    <Vitrina />
  </div>

  {podderzhka && <>
  <script is:inline define:vars={{ support }}>window.MUSEUM_SUPPORT = support;</script>
  <script is:inline src={`${base}assets/museum-support.js`} defer></script>
  </>}

  <Fragment slot="footer"><p class="p-park">{s('portalPark')}</p></Fragment>
</Base>
