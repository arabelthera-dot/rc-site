---
interface Props { title: string; description?: string; museum?: string; crumbs?: { href?: string; label: string }[]; back?: { href: string; label: string } }
const { title, description, museum, crumbs = [], back } = Astro.props;
import "../styles/museum.css";
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ru" data-museum={museum}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta property="og:site_name" content="Русская цивилизация" />
  <meta property="og:locale" content="ru_RU" />
  <meta name="theme-color" content="#060d18" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
</head>
<body>
  {back && <a class="backbtn" href={back.href}><span class="ar">←</span>{back.label}</a>}
  <slot name="header" />
  {crumbs.length > 0 && (
    <nav class="crumbs">
      <a href={base}>Русская цивилизация</a>
      {crumbs.map((c) => (<> › {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</>))}
    </nav>
  )}
  <main><slot /></main>
  <footer>
    <div class="slog">Цивилизация первенств — что Россия дала миру раньше всех</div>
    <slot name="footer"><a href={base}>в город-музей →</a></slot>
  </footer>
</body>
</html>
