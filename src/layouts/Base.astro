---
interface Props { title: string; rss?: { href: string; title: string }; ogTitle?: string; description?: string; image?: string; imageAlt?: string; type?: 'website' | 'article'; museum?: string; crumbs?: { href?: string; label: string }[]; museumTitle?: string; here?: string; back?: { href: string; label: string }; ownStyle?: boolean; noindex?: boolean; ogFallback?: string; about?: string; temporal?: string; portal?: boolean; schema?: 'home' | 'museum' | 'calendar' | 'article' | 'page' }
const { title, ogTitle, description, image, imageAlt, type = 'website', museum, crumbs = [], museumTitle, here, back, ownStyle = false, rss, portal = false } = Astro.props;
import SiteBar from '../components/SiteBar.astro';
import InlineCss from '../components/InlineCss.astro';
import Metrika from '../components/Metrika.astro';
import Yazyki from '../components/Yazyki.astro';
import { yazyk, razobratPut, hreflangi } from '../lib/yazyki.mjs';
import { podpiskaHtml } from '../lib/sitebar.mjs';
import { fontFiles } from '../lib/shrifty.mjs';
import nastroyki from '../data/nastroyki.json';
// museum.css — ссылкой, а не импортом: главная портала (portal) его не грузит, у неё своя выписка
// src/styles/portal-base.css (AI_Projects#2004 п.7). Ссылка стоит там же, где Astro ставил общий стиль, — после слота head.
import museumCss from '../styles/museum.css?url';
const base = import.meta.env.BASE_URL;
// Свой стиль музея переносится из старого сайта как есть (public/muzei/<slug>/*-style.css, план шаг 4);
// нет файла — страница на общем museum.css. Как на старом сайте — только у страниц дня (ownStyle):
// календарь и главная музея там на своём общем стиле.
const fs = await import('node:fs');
const own = ownStyle && museum && fs.existsSync(`public/muzei/${museum}`)
  ? fs.readdirSync(`public/muzei/${museum}`).find((f: string) => f.endsWith('-style.css')) : undefined;
// Паспорт для поиска и пересылки (Open Graph, «да» Сергея 16.10): картинка превью — своя у страницы,
// иначе обложка музея со старого сайта (public/og/<музей>_index.jpg), иначе общая og-default.jpg.
// Шрифт заголовков из своего стиля музея (--font-h) набирает название музея в шапке и h1 дня: его файлы
// (кириллица + латиница, 700) — заранее, иначе Georgia до загрузки переносит название иначе и страница
// прыгает (CLS 0,19 у «Не сдаются», P1 16.10). Файлы — из fonts.css, руками не перечисляются.
const headFont = own && /--font-h:\s*'([^']+)'/.exec(fs.readFileSync(`public/muzei/${museum}/${own}`, 'utf8'))?.[1];
const headFiles = headFont ? fontFiles([headFont], ['700']) : [];
const url = new URL(Astro.url.pathname, Astro.site).href;
// Нет обложки музея — первая настоящая растровая картинка его дней (ogFallback, главная и календарь музея, 19.10):
// иначе у 30 из 33 музеев пересылка главной и календаря шла общей og-default.jpg. SVG Telegram/ВК не показывают.
const raster = (s?: string) => !!s && /\.(?:jpe?g|png|webp|gif)(?:[?#].*)?$/i.test(s);
const fallback = raster(Astro.props.ogFallback) ? Astro.props.ogFallback!.replace(/^(?!https?:)\/?/, base) : undefined;
const ogFile = museum && fs.existsSync(`public/og/${museum}_index.jpg`) ? `${base}og/${museum}_index.jpg` : fallback ?? `${base}og/og-default.jpg`;
// Превью-сборка не для поисковиков: PUBLIC_NOINDEX=1 (deploy.yml, задача build) → noindex; по умолчанию индексируем.
// Своя страница может попросить noindex (заглушка «День готовится»).
const noindex = Astro.props.noindex || import.meta.env.PUBLIC_NOINDEX === '1';
const ogImage = new URL(image ?? ogFile, Astro.site).href;
// Разметка schema.org (JSON-LD, пункт «schema» замера glazami): тип — из пропса schema, иначе по пропсам:
// главная — WebSite + Organization, главная музея — Museum, календарь — CollectionPage, день — Article, прочее — WebPage.
// У дня about — предмет дня (его title), temporalCoverage — год события (поле year); нет поля — ключа нет (JSON.stringify
// выбрасывает undefined). SearchAction у WebSite нет: поиск (интеграция poisk) по умолчанию выключен (Д5 плана сайта, 19.10).
const home = new URL(base, Astro.site).href;
const org = { '@type': 'Organization', name: 'Русская цивилизация', url: home };
const museumLd = museum && museumTitle ? { '@type': 'Museum', name: museumTitle, url: new URL(`${base}muzei/${museum}/`, Astro.site).href } : undefined;
const kind = Astro.props.schema ?? (Astro.url.pathname.replace(/\/?$/, '/') === base.replace(/\/?$/, '/') ? 'home' : type === 'article' && museumLd ? 'article'
  : museumLd && here ? 'calendar' : museumLd ? 'museum' : 'page');
const ldName = ogTitle ?? title;
const ld = kind === 'home'
  ? [{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Русская цивилизация', url: home, inLanguage: 'ru', description, publisher: org },
     { '@context': 'https://schema.org', ...org, logo: new URL(`${base}og/index.jpg`, Astro.site).href }]
  : kind === 'museum' ? { '@context': 'https://schema.org', ...museumLd, description, image: ogImage, parentOrganization: org }
  : kind === 'calendar' ? { '@context': 'https://schema.org', '@type': 'CollectionPage', name: ldName, url, inLanguage: 'ru', description, isPartOf: museumLd }
  : kind === 'article' ? { '@context': 'https://schema.org', '@type': 'Article', headline: ldName, url, inLanguage: 'ru', description, image: ogImage, isPartOf: museumLd, publisher: org,
      about: Astro.props.about ? { '@type': 'Thing', name: Astro.props.about } : undefined, temporalCoverage: Astro.props.temporal }
  : { '@context': 'https://schema.org', '@type': 'WebPage', name: ldName, url, inLanguage: 'ru', description, isPartOf: { '@type': 'WebSite', name: 'Русская цивилизация', url: home } };
const ldJson = JSON.stringify(ld).replace(/</g, '\\u003c');
// Яндекс Метрика — на всех страницах, кроме служебной доски (/doska/).
// Язык страницы — по приставке адреса (/en/… и т.п., src/data/yazyki.json); русский — без приставки.
// hreflang — только готовые языки (ready:true) + x-default, чтобы не ссылаться на несуществующие страницы (план сайта Г19).
const lang = yazyk(razobratPut(Astro.url.pathname, base).code);
const alternates = hreflangi(Astro.url.pathname, base, Astro.site);
const metrika = !Astro.url.pathname.startsWith(`${base}doska`);
// «Нашли ошибку?» (Д6) — только на страницах музея/дня и только при флаге knopkaOshibka (src/data/nastroyki.json, по умолчанию выкл.).
// Ссылка на новую карточку доски AI_Projects с предзаполненными заголовком, текстом и меткой; без токенов и сервера.
const oshibkaUrl = nastroyki.knopkaOshibka && museum ? 'https://github.com/arabelthera-dot/AI_Projects/issues/new?' + new URLSearchParams({
  title: `Ошибка на сайте: ${Astro.url.pathname}`,
  body: `Страница: ${url}\n\nЧто не так:\n\n`,
  labels: 'oshibka-s-sayta',
}).toString() : undefined;
---
<!doctype html>
<html lang={lang.code} dir={lang.dir} data-museum={museum}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {noindex && <meta name="robots" content="noindex" />}
  {description && <meta name="description" content={description} />}
  <meta property="og:site_name" content="Русская цивилизация" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={ogTitle ?? title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={url} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={imageAlt ?? title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle ?? title} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={ogImage} />
  <link rel="sitemap" href={`${base}sitemap-index.xml`} />
  <link rel="alternate" type="application/rss+xml" title="Русская цивилизация — новые дни музеев" href={`${base}rss.xml`} />
  {rss && <link rel="alternate" type="application/rss+xml" title={rss.title} href={rss.href} />}
  <meta name="theme-color" content="#060d18" />
  <link rel="canonical" href={url} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
  <!-- Inter (шапка дня, крошки, блок «Поддержать») и PT Serif (основной текст вместо системного Georgia, 17.10) —
       оба объявлены в museum.css; файлы
       (кириллица + латиница с цифрами) — заранее, иначе после их загрузки страница перескакивает (CLS, приёмка
       M1 16.10). На главной портала Inter нет — там не качаем. -->
  {museum && <>
    <link rel="preload" href={`${base}assets/fonts/inter-UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa0ZL7SUc.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}assets/fonts/inter-UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}assets/fonts/ptserif-EJRVQgYoZZY2vCFuvAFSzr-tdg.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}assets/fonts/ptserif-EJRVQgYoZZY2vCFuvAFWzr8.woff2`} as="font" type="font/woff2" crossorigin />
  </>}
  {headFiles.map((f) => <link rel="preload" href={`${base}assets/fonts/${f}`} as="font" type="font/woff2" crossorigin />)}
  {own && <link rel="stylesheet" href={`${base}muzei/${museum}/${own}`} />}
  {/* блок «Поддержать» внизу каждой страницы — 1,7 КБ, внутрь <head> вместо блокирующего запроса (18.10) */}
  <InlineCss file="rc-podpiska.css" />
  {museum && museumTitle && <>
    <link rel="stylesheet" href={`${base}assets/rc-sitebar.css`} />
    <script is:inline defer src={`${base}assets/rc-sitebar.js`}></script>
  </>}
  <script type="application/ld+json" set:html={ldJson} />
  {metrika && <Metrika />}
  <slot name="head" />
  {!portal && <link rel="stylesheet" href={museumCss} />}
</head>
<body>
  <Yazyki />
  {/* Страницы музеев — единая верхняя полоса (Сергей 17.10) вместо крошек и кнопки «назад» */}
  {museum && museumTitle && <SiteBar slug={museum} title={museumTitle} here={here} />}
  {!(museum && museumTitle) && back && <a class="backbtn" href={back.href}><span class="ar">←</span>{back.label}</a>}
  <slot name="header" />
  {!(museum && museumTitle) && crumbs.length > 0 && (
    <nav class="crumbs">
      <a href={base}>Русская цивилизация</a>
      {crumbs.map((c) => (<> › {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</>))}
    </nav>
  )}
  <main><slot /></main>
  <Fragment set:html={podpiskaHtml()} />
  <footer>
    <div class="slog">Цивилизация первенств — что Россия дала миру раньше всех</div>
    <slot name="footer"><a href={base}>в город-музей →</a></slot>
    <div class="politika"><a href={`${base}politika-konfidencialnosti/`}>Политика конфиденциальности</a></div>
    <div class="foot-links"><a href={`${base}o-proekte/`}>О проекте</a> · <a href={`${base}kontakty/`}>Контакты</a>{oshibkaUrl && <> · <a class="oshibka" href={oshibkaUrl} target="_blank" rel="noopener nofollow">Нашли ошибку?</a></>}</div>
  </footer>
  <script is:inline defer src={`${base}assets/analytics.js`}></script>
</body>
</html>
