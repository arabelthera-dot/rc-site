---
interface Props { title: string; ogTitle?: string; description?: string; image?: string; imageAlt?: string; type?: 'website' | 'article'; museum?: string; crumbs?: { href?: string; label: string }[]; back?: { href: string; label: string }; ownStyle?: boolean }
const { title, ogTitle, description, image, imageAlt, type = 'website', museum, crumbs = [], back, ownStyle = false } = Astro.props;
import "../styles/museum.css";
const base = import.meta.env.BASE_URL;
// Свой стиль музея переносится из старого сайта как есть (public/muzei/<slug>/*-style.css, план шаг 4);
// нет файла — страница на общем museum.css. Как на старом сайте — только у страниц дня (ownStyle):
// календарь и главная музея там на своём общем стиле.
const fs = await import('node:fs');
const own = ownStyle && museum && fs.existsSync(`public/muzei/${museum}`)
  ? fs.readdirSync(`public/muzei/${museum}`).find((f: string) => f.endsWith('-style.css')) : undefined;
// Паспорт для поиска и пересылки (Open Graph, «да» Сергея 16.10): картинка превью — своя у страницы,
// иначе обложка музея со старого сайта (public/og/<музей>_index.jpg), иначе общая og-default.jpg.
// Шрифт заголовков из своего стиля музея (--font-h) набирает название музея в шапке и h1 дня: его файлы
// (кириллица + латиница, 700) — заранее, иначе Georgia до загрузки переносит название иначе и страница
// прыгает (CLS 0,19 у «Не сдаются», P1 16.10). Файлы — из fonts.css, руками не перечисляются.
const headFont = own && /--font-h:\s*'([^']+)'/.exec(fs.readFileSync(`public/muzei/${museum}/${own}`, 'utf8'))?.[1];
const headFiles = headFont ? [...fs.readFileSync('public/assets/fonts.css', 'utf8').matchAll(
  /\/\* (?:cyrillic|latin) \*\/\s*@font-face \{[^}]*font-family: '([^']+)';[^}]*font-style: normal;[^}]*font-weight: 700;[^}]*url\(fonts\/([^)]+)\)/g)]
  .filter((m) => m[1] === headFont).map((m) => m[2]) : [];
const url = new URL(Astro.url.pathname, Astro.site).href;
const ogFile = museum && fs.existsSync(`public/og/${museum}_index.jpg`) ? `og/${museum}_index.jpg` : 'og/og-default.jpg';
const ogImage = new URL(image ?? `${base}${ogFile}`, Astro.site).href;
---
<!doctype html>
<html lang="ru" data-museum={museum}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta property="og:site_name" content="Русская цивилизация" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={ogTitle ?? title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={url} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={imageAlt ?? title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle ?? title} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={ogImage} />
  <link rel="sitemap" href={`${base}sitemap-index.xml`} />
  <meta name="theme-color" content="#060d18" />
  <link rel="canonical" href={url} />
  <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
  <!-- Inter (объявлен в museum.css) набирает на страницах музеев шапку дня, крошки и блок «Поддержать»: файлы
       (кириллица + латиница с цифрами) — заранее, иначе после их загрузки страница перескакивает (CLS, приёмка
       M1 16.10). На главной портала Inter нет — там не качаем. -->
  {museum && <>
    <link rel="preload" href={`${base}assets/fonts/inter-UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa0ZL7SUc.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}assets/fonts/inter-UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2`} as="font" type="font/woff2" crossorigin />
  </>}
  {headFiles.map((f) => <link rel="preload" href={`${base}assets/fonts/${f}`} as="font" type="font/woff2" crossorigin />)}
  {own && <link rel="stylesheet" href={`${base}muzei/${museum}/${own}`} />}
  <slot name="head" />
</head>
<body>
  {back && <a class="backbtn" href={back.href}><span class="ar">←</span>{back.label}</a>}
  <slot name="header" />
  {crumbs.length > 0 && (
    <nav class="crumbs">
      <a href={base}>Русская цивилизация</a>
      {crumbs.map((c) => (<> › {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</>))}
    </nav>
  )}
  <main><slot /></main>
  <footer>
    <div class="slog">Цивилизация первенств — что Россия дала миру раньше всех</div>
    <slot name="footer"><a href={base}>в город-музей →</a></slot>
  </footer>
  <script is:inline defer src={`${base}assets/analytics.js`}></script>
</body>
</html>
