    "belyy": { "$value": "#ffffff" }, "chernyy": { "$value": "#000000" }, "temnyy": { "$value": "#12151c" },
    "sinij": { "$value": "#2d8cbf" }, "goluboy": { "$value": "#7dc8ff" }, "bezh": { "$value": "#e9e3d3" }
  },
  "muzei": {
